<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">
  <!-- Two PMs of 2 cores, the second being twice as fast. Each loaded core dissipates 1W, and idle cores nothing. -->
  <zone id="world" routing="Full">
    <host id="slow" speed="1Gf" core="2">
      <prop id="wattage_per_state" value="0.0:0.0:2.0" />
      <prop id="wattage_off" value="0.0" />
    </host>
    <host id="fast" speed="2Gf" core="2">
      <prop id="wattage_per_state" value="0.0:0.0:2.0" />
      <prop id="wattage_off" value="0.0" />
    </host>
    <link id="link" bandwidth="1.25GBps" latency="0" sharing_policy="FATPIPE" />
    <route src="slow" dst="fast"><link_ctn id="link" /></route>
  </zone>
</platform>
