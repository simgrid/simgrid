p A write after the fence that closes the epoch is ordered after the put
$ $VALGRIND_NO_TRACE_CHILDREN "${bindir:=.}/../../smpi_script/bin/smpirun" -quiet -wrapper "${bindir:=.}/../../bin/simgrid-mc --cfg=model-check/reduction:odpor" --log=xbt_cfg.thresh:warning --log=no_loc -platform ${srcdir:=.}/../../examples/platforms/cluster_backbone.xml -np 2 "${bindir:=.}/mpi_rma_put_race" after
