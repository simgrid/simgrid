#!/usr/bin/env tesh

$ "${bindir:=.}/../../smpi_script/bin/smpicc" -smemory -g "${srcdir:=.}/mpi/rma_put_race.c" -o "${bindir:=.}/mpi_rma_put_race"
> Successfully instrumented 24 read operations and 7 writes operations

p The put of rank 0 races with a write of rank 1 in the same epoch
! expect return 5
