#!/usr/bin/env tesh

$ ${clang:=clang} -g -fpass-plugin=${smemory_pass} plusplus.c ${libsthread} -o ${bindir:=.}/teshsuite/mc/plusplus/plusplus
> Successfully instrumented 9 read operations and 8 writes operations

# We ignore the LD_PRELOAD lines from the expected output because they contain the build path
! ignore .*LD_PRELOAD.*
# The app runs one-way and may reach the final assert before the checker kills it on the datarace, or not
! ignore .*Assertion `i == 2' failed.*

! expect return 5
$ $VALGRIND_NO_TRACE_CHILDREN ${bindir:=.}/bin/simgrid-mc --log=no_loc --cfg=model-check/setenv:LD_PRELOAD=${libsthread} -- ${bindir:=.}/teshsuite/mc/plusplus/plusplus  --log=xbt_cfg.thresh:critical --log=no_loc
> [0.000000] [mc_dfs/INFO] Start a DFS exploration. Reduction is: dpor.
> [0.000000] [mc_explo/INFO] Found a data race at location 0xdeadbeaf: two actors access this memory without synchronization, and at least one of them writes it.
> [0.000000] [mc_explo/INFO]   Access 1: WRITE by actor 2, done after transition #1 and before transition #3
> [0.000000] [mc_explo/INFO]   Access 2: WRITE by actor 3, done after transition #2 and before transition #5
> [0.000000] [mc_explo/INFO]   No synchronization (such as a join or a mutex) forces access 1 to happen before access 2, so they may happen in any order.
> [0.000000] [mc_explo/INFO] Execution leading to the race:
> [0.000000] [mc_explo/INFO]   #1 Actor 1 in simcall ActorCreate(child 2)
> [0.000000] [mc_explo/INFO]   #2 Actor 1 in simcall ActorCreate(child 3)
> [0.000000] [mc_explo/INFO]   #3 Actor 2 in simcall ActorExit()     <== access 1 (WRITE by actor 2) happened before this transition
> [0.000000] [mc_explo/INFO]   #4 Actor 1 in simcall ActorJoin(target 2, no timeout)
> [0.000000] [mc_explo/INFO]   #5 Actor 3 in simcall ActorExit()     <== access 2 (WRITE by actor 3) happened before this transition
> [0.000000] [mc_explo/INFO] To see the source line of each access, rerun this execution through simgrid-mc with the same options, adding --cfg=model-check/replay:'1;1;2;1;3'
> [0.000000] [mc_dfs/INFO] DFS exploration ended. 6 unique states visited; 0 explored traces (0 transition replays, 5 states visited overall)

# The same race, found by the BeFS explorer
! ignore .*LD_PRELOAD.*
! ignore .*Assertion `i == 2' failed.*
! expect return 5
$ $VALGRIND_NO_TRACE_CHILDREN ${bindir:=.}/bin/simgrid-mc --log=no_loc --cfg=model-check/setenv:LD_PRELOAD=${libsthread} --cfg=model-check/exploration-algo:BeFS -- ${bindir:=.}/teshsuite/mc/plusplus/plusplus  --log=xbt_cfg.thresh:critical --log=no_loc
> [0.000000] [xbt_cfg/INFO] Configuration change: Set 'model-check/exploration-algo' to 'BeFS'
> [0.000000] [mc_befs/INFO] Start a BeFS exploration. Reduction is: dpor.
> [0.000000] [mc_explo/INFO] Found a data race at location 0xdeadbeaf: two actors access this memory without synchronization, and at least one of them writes it.
> [0.000000] [mc_explo/INFO]   Access 1: WRITE by actor 2, done after transition #1 and before transition #3
> [0.000000] [mc_explo/INFO]   Access 2: WRITE by actor 3, done after transition #2 and before transition #5
> [0.000000] [mc_explo/INFO]   No synchronization (such as a join or a mutex) forces access 1 to happen before access 2, so they may happen in any order.
> [0.000000] [mc_explo/INFO] Execution leading to the race:
> [0.000000] [mc_explo/INFO]   #1 Actor 1 in simcall ActorCreate(child 2)
> [0.000000] [mc_explo/INFO]   #2 Actor 1 in simcall ActorCreate(child 3)
> [0.000000] [mc_explo/INFO]   #3 Actor 2 in simcall ActorExit()     <== access 1 (WRITE by actor 2) happened before this transition
> [0.000000] [mc_explo/INFO]   #4 Actor 1 in simcall ActorJoin(target 2, no timeout)
> [0.000000] [mc_explo/INFO]   #5 Actor 3 in simcall ActorExit()     <== access 2 (WRITE by actor 3) happened before this transition
> [0.000000] [mc_explo/INFO] To see the source line of each access, rerun this execution through simgrid-mc with the same options, adding --cfg=model-check/replay:'1;1;2;1;3'
> [0.000000] [mc_befs/INFO] BeFS exploration ended. 6 unique states visited; 0 explored traces (0 transition replays, 6 states visited overall)

# The same race, found by the parallel explorer. It is reported by the thread that found it, and the other threads are
# stopped. Which thread gets the work depends on the timing, so the end messages of the threads are ignored.
! ignore .*LD_PRELOAD.*
! ignore .*Assertion `i == 2' failed.*
! ignore .*\[tid: Explorer .*
! expect return 5
$ $VALGRIND_NO_TRACE_CHILDREN ${bindir:=.}/bin/simgrid-mc --log=no_loc --cfg=model-check/setenv:LD_PRELOAD=${libsthread} --cfg=model-check/exploration-algo:parallel --cfg=model-check/parallel-thread:2 -- ${bindir:=.}/teshsuite/mc/plusplus/plusplus  --log=xbt_cfg.thresh:critical --log=no_loc
> [0.000000] [xbt_cfg/INFO] Configuration change: Set 'model-check/exploration-algo' to 'parallel'
> [0.000000] [xbt_cfg/INFO] Configuration change: Set 'model-check/parallel-thread' to '2'
> [0.000000] [mc_parallel/INFO] Start a Parallel exploration with 2 threads. Reduction is: dpor.
> [0.000000] [mc_explo/INFO] Found a data race at location 0xdeadbeaf: two actors access this memory without synchronization, and at least one of them writes it.
> [0.000000] [mc_explo/INFO]   Access 1: WRITE by actor 2, done after transition #1 and before transition #3
> [0.000000] [mc_explo/INFO]   Access 2: WRITE by actor 3, done after transition #2 and before transition #5
> [0.000000] [mc_explo/INFO]   No synchronization (such as a join or a mutex) forces access 1 to happen before access 2, so they may happen in any order.
> [0.000000] [mc_explo/INFO] Execution leading to the race:
> [0.000000] [mc_explo/INFO]   #1 Actor 1 in simcall ActorCreate(child 2)
> [0.000000] [mc_explo/INFO]   #2 Actor 1 in simcall ActorCreate(child 3)
> [0.000000] [mc_explo/INFO]   #3 Actor 2 in simcall ActorExit()     <== access 1 (WRITE by actor 2) happened before this transition
> [0.000000] [mc_explo/INFO]   #4 Actor 1 in simcall ActorJoin(target 2, no timeout)
> [0.000000] [mc_explo/INFO]   #5 Actor 3 in simcall ActorExit()     <== access 2 (WRITE by actor 3) happened before this transition
> [0.000000] [mc_explo/INFO] To see the source line of each access, rerun this execution through simgrid-mc with the same options, adding --cfg=model-check/replay:'1;1;2;1;3'

! setenv LD_PRELOAD=${libsthread}
! expect signal SIGIOT
$ ${bindir:=.}/teshsuite/mc/plusplus/plusplus --cfg=model-check/replay:'1;1;2;1;3' --log=no_loc
> sthread is intercepting the execution of teshsuite/mc/plusplus/plusplus. If it's not what you want, export STHREAD_IGNORE_BINARY=teshsuite/mc/plusplus/plusplus
