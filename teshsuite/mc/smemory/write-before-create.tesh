#!/usr/bin/env tesh

$ ${clang:=clang} -g -fpass-plugin=${smemory_pass} write-before-create.c ${libsthread} -o ${bindir:=.}/teshsuite/mc/write-before-create/write-before-create
> Successfully instrumented 3 read operations and 4 writes operations

# Without reduction, the exploration replays the beginning of the execution several times
! ignore .*LD_PRELOAD.*
$ $VALGRIND_NO_TRACE_CHILDREN ${bindir:=.}/bin/simgrid-mc --log=no_loc --cfg=model-check/setenv:LD_PRELOAD=${libsthread} --cfg=model-check/reduction:none -- ${bindir:=.}/teshsuite/mc/write-before-create/write-before-create --log=xbt_cfg.thresh:critical --log=no_loc
> [0.000000] [xbt_cfg/INFO] Configuration change: Set 'model-check/reduction' to 'none'
> [0.000000] [mc_dfs/INFO] Start a DFS exploration. Reduction is: none.
> [0.000000] [mc_dfs/INFO] DFS exploration ended. 27 unique states visited; 5 explored traces (9 transition replays, 36 states visited overall)
